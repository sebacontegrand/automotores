# Database
DATABASE_URL="postgresql://user:password@localhost:5432/autovault"

# Pusher Realtime
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="your_pusher_cluster"
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_secret"

# Auth
# ACCESS_CODE_HASH: bcrypt hash for the 4-digit code (homepage access)
ACCESS_CODE_HASH="\$2b\$10\$..."
# SECRET_PASSWORD_HASH: bcrypt hash for the full password (chat + homepage access)
SECRET_PASSWORD_HASH="\$2b\$10\$..."
SESSION_SECRET="your-secure-random-string-at-least-32-chars-long"
